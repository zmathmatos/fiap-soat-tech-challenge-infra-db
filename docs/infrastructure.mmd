        RDS_LAYER
  end
 subgraph AWS["Amazon Web Services - us-east-1"]
        S3["Simple Storage Service (S3)<br>tfstate: infra-db<br>+ infra-k8s (read only)"]
        VPC
  end
    SUBNETS --> RDS
    EKS --> SG
    SG --> RDS
    S3 -.-> RDS

    classDef aws       fill:#F5F5F5,stroke:#666,stroke-width:1px
